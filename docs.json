{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Tradion Docs",
  "description": "Learn how to use Tradion. The AI analyst built for how you trade.",
  "colors": {
    "primary": "#459e6b",
    "light": "#5cb883",
    "dark": "#3a8459"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/tradion.png",
    "dark": "/logo/tradion.png",
    "href": "https://tradionlabs.com"
  },
  "navbar": {
    "links": [
      { "label": "Support", "href": "mailto:contact@tradionlabs.com" }
    ],
    "primary": {
      "type": "button",
      "label": "Open Tradion",
      "href": "https://app.tradionlabs.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tradionlabs",
      "linkedin": "https://www.linkedin.com/company/tradion-labs"
    },
    "links": [
      {
        "header": "Navigation",
        "items": [
          { "label": "Start Free Trial", "href": "https://app.tradionlabs.com" },
          { "label": "Products", "href": "https://tradionlabs.com/#features" },
          { "label": "Pricing", "href": "https://tradionlabs.com/#pricing" },
          { "label": "Docs", "href": "https://docs.tradionlabs.com" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "About", "href": "https://tradionlabs.com/about" },
          { "label": "Careers", "href": "https://tradionlabs.com/careers" },
          { "label": "Contact", "href": "https://tradionlabs.com/contact" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Terms of Service", "href": "https://tradionlabs.com/terms" },
          { "label": "Privacy Policy", "href": "https://tradionlabs.com/privacy" },
          { "label": "Risk Disclosure", "href": "https://tradionlabs.com/risk-disclosure" }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the Tradion docs"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/portfolio/ai-asset-manager",
      "destination": "/portfolio/ai-portfolio-analyst",
      "permanent": true
    },
    {
      "source": "/research/earnings-spider",
      "destination": "/research/ai-earnings-research",
      "permanent": true
    },
    {
      "source": "/research/quant-research",
      "destination": "/portfolio/ai-portfolio-analyst",
      "permanent": true
    },
    {
      "source": "/research/your-first-analysis",
      "destination": "/portfolio/ai-portfolio-analyst",
      "permanent": true
    },
    {
      "source": "/research/the-canvas",
      "destination": "/portfolio/ai-portfolio-analyst",
      "permanent": true
    },
    {
      "source": "/research/templates-and-scenarios",
      "destination": "/portfolio/ai-portfolio-analyst",
      "permanent": true
    },
    {
      "source": "/automations/:slug*",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/reference/webhook-payloads",
      "destination": "/get-started/welcome",
      "permanent": true
    },
    {
      "source": "/reference/technical-indicators",
      "destination": "/research/chart-analyzer",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/welcome",
              "get-started/quickstart",
              "get-started/creating-your-account",
              "get-started/onboarding",
              "get-started/choosing-a-plan",
              "get-started/tour"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/the-loop",
              "concepts/tradion-memory",
              "concepts/reading-a-verdict",
              "concepts/data-sources",
              "concepts/usage-limits"
            ]
          },
          {
            "group": "Portfolio",
            "pages": [
              "portfolio/overview",
              "portfolio/connect-brokerage",
              "portfolio/reading-the-dashboard",
              "portfolio/ai-portfolio-analyst"
            ]
          },
          {
            "group": "Research & Analysis",
            "pages": [
              "research/chart-analyzer",
              "research/lens",
              "research/ai-earnings-research",
              "research/earnings-evidence",
              "research/earnings-notebook"
            ]
          },
          {
            "group": "Trade Intelligence",
            "pages": [
              "trade-intelligence/trade-autopsy",
              "trade-intelligence/logging-a-trade",
              "trade-intelligence/importing-broker-trades",
              "trade-intelligence/reading-an-autopsy",
              "trade-intelligence/playbook-and-preflight",
              "trade-intelligence/profile"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/managing-subscription",
              "account/settings",
              "account/deleting-your-account"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/troubleshooting",
              "help/faq",
              "help/glossary",
              "help/contact"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/plan-comparison",
              "reference/supported-assets"
            ]
          }
        ]
      }
    ]
  }
}
