{
  "name": "tradion-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "docs.tradionlabs.com \u2014 Mintlify site and screenshot pipeline",
  "scripts": {
    "dev": "mint dev",
    "check": "mint broken-links",
    "illustrations": "node scripts/build-illustrations.mjs",
    "audit": "node scripts/audit-content.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "verify": "npm run illustrations && npm run verify:nav && npm run audit && npm run check:code",
    "shots": "tsx scripts/capture.ts",
    "shots:headed": "tsx scripts/capture.ts --headed",
    "check:code": "node scripts/check-against-code.mjs"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.2",
    "mint": "^4.2.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0"
  }
}
